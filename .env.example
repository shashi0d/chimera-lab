# Copy to .env (repo root) and fill in. Never commit .env. These keys are spent on use.

# ---------------------------------------------------------------- Models (required)
# Meta API: Muse Image draws every image (Fusion, Revise, Paint, Draw, card angles); Muse Spark reads images
# (identifying photos, the topic check, the creature profile).
META_API_KEY=
# Optional overrides (defaults shown). Models available to a key: GET <base url>/models.
# META_API_BASE_URL=https://api.meta.ai/v1
# META_IMAGE_MODEL=muse-image-1.0
# META_VISION_MODEL=muse-spark-1.3
# Per-attempt timeouts in seconds.
# IDENTIFY_TIMEOUT_SECONDS=20
# VISION_TIMEOUT_SECONDS=60
# GENERATE_TIMEOUT_SECONDS=80

# ---------------------------------------------------------------- Supabase (database, image storage)
# Without them: local SQLite and files under .localdata, Setup: README.md > Supabase.
SUPABASE_URL=
# Server-side secret key (sb_secret_...); SUPABASE_SERVICE_KEY is also accepted. Never expose it to the browser.
SUPABASE_SECRET_KEY=

# ---------------------------------------------------------------- Fusion
# The prompt ({a} and {b} are the two animals), before the art style and the background rule are added.
EVO_FUSION_PROMPT="create a hybrid of {a} and {b}"
# EVO_FUSION_BACKGROUND="Show the whole creature, centred, on a plain pure white background with no scenery."

# ---------------------------------------------------------------- Limits
# false: no daily caps or per-minute rate limits (usage is still counted). Turn on before sharing a public link.
EVO_LIMITS_ENABLED=false
# Daily caps when on (defaults): Fusion runs 50 total / 3 per user; edits and cards 100 total / 20 per user.
# EVO_DAILY_RUNS=50
# EVO_VISITOR_DAILY_RUNS=3
# LAB_DAILY_ACTIONS=100
# LAB_USER_DAILY_ACTIONS=20
# Lifetime images per visitor, on even when the daily caps are off (never resets): a Fusion or an edit uses 1,
# an animal card 4. 0 = no limit.
# EVO_VISITOR_IMAGE_LIMIT=30

# ---------------------------------------------------------------- Deploying to Modal (docs/DEPLOY.md)
# Deploy credentials for the Modal CLI (Modal dashboard: Settings > API Tokens, or `modal token new`). The app never
# reads them. The deployed app reads the Modal secret `chimera-lab`, made from this file by scripts/modal-setup.sh.
MODAL_TOKEN_ID=
MODAL_TOKEN_SECRET=
