# Copy to .env and fill in. Never commit .env.
CHIMERA_MODE=mock
META_API_KEY=
# S1: Muse Spark Open on Baseten (OpenAI-compatible, https://inference.baseten.co/v1)
BASETEN_API_KEY_MODEL_MUSE_SPARK_OPEN_26=
# Optional: Supabase for persistent storage (else local SQLite and files under .localdata).
# Run backend/app/adapters/supabase/schema.sql, 001_agent_api.sql, 002_lockdown_and_indexes.sql,
# 003_table_grants.sql first.
SUPABASE_URL=
# Server-side secret key (sb_secret_...); SUPABASE_SERVICE_KEY is also accepted. Never expose it to the browser.
SUPABASE_SECRET_KEY=
