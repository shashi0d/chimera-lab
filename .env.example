# Copy to .env (repo root) and fill in. Never commit .env. Chimera Lab is live-only: these keys are spent on use.

# ---------------------------------------------------------------- Hosting on Modal (modal.com)
# Deploy credentials for the Modal CLI (Modal dashboard: Settings > API Tokens, or `modal token new`). Used only on
# the machine that deploys; the app never reads them.
MODAL_TOKEN_ID=
MODAL_TOKEN_SECRET=
# Optional: the Modal environment to deploy into (default: your workspace's default environment).
# MODAL_ENVIRONMENT=main
#
# The deployed app does not read this file. It reads a Modal secret named `chimera-lab` (backend/app/modal_app.py)
# holding the app variables below (META_API_KEY, SUPABASE_*, EVO_*, ...). Create or update it, then deploy:
#   modal secret create chimera-lab --from-dotenv .env.modal --force
#   (cd frontend && npm run build) && modal deploy backend/app/modal_app.py
# where .env.modal is a copy of .env without the MODAL_* lines and without SUPABASE_DB_URL.
# After the first deploy, add the app's URL (https://<workspace>--chimera-lab-fastapi-app.modal.run) to Supabase:
# Authentication > URL Configuration > Site URL and Redirect URLs (<url>/**), or sign-in links go to localhost.

# ---------------------------------------------------------------- Models
# Meta API (required): every image (Muse Image: Fusion, Revise, Paint, Draw, card angles) and the vision calls
# (Muse Spark: identifying photos, the topic check, the creature profile).
META_API_KEY=
# Optional overrides (defaults shown). Models available to a key: GET <base url>/models.
# META_API_BASE_URL=https://api.meta.ai/v1
# META_IMAGE_MODEL=muse-image-1.0
# META_VISION_MODEL=muse-spark-1.3

# Baseten, Muse Spark Open (OpenAI-compatible): the algorithm-mode agent and its routed calls. Not needed in prompt
# mode; without it, those calls fall back to the Meta API.
BASETEN_API_KEY_MODEL_MUSE_SPARK_OPEN_26=
# Optional overrides (defaults shown).
# BASETEN_BASE_URL=https://inference.baseten.co/v1
# BASETEN_SPARK_MODEL=meta-models/muse-spark-open-1026

# Optional per-attempt timeouts in seconds (defaults shown).
# IDENTIFY_TIMEOUT_SECONDS=20
# GENERATE_TIMEOUT_SECONDS=80
# BASETEN_TIMEOUT_SECONDS=300

# Supabase: Postgres, Storage and Auth (sign-in). Without them: local SQLite and files under .localdata, no sign-in.
# Run backend/app/adapters/supabase/schema.sql, then 001 to 004 in order. Sign-in setup: docs/LAB.md.
SUPABASE_URL=
# Server-side secret key (sb_secret_...); SUPABASE_SERVICE_KEY is also accepted. Never expose it to the browser.
SUPABASE_SECRET_KEY=
# Browser-safe key (sb_publishable_...): served to the frontend by GET /evo/config for sign-in.
SUPABASE_PUBLISHABLE_KEY=
# Only for running SQL migrations by script (postgresql://...). The app never uses it; remove it when done.
# SUPABASE_DB_URL=

# Optional daily caps (defaults): Fusion runs 50 total / 3 per user; lab actions 100 total / 20 per user.
# EVO_DAILY_RUNS=50
# EVO_VISITOR_DAILY_RUNS=3
# LAB_DAILY_ACTIONS=100
# LAB_USER_DAILY_ACTIONS=20

# Fusion mode: "prompt" = one image from EVO_FUSION_PROMPT ({a}, {b} = the two animals);
# "algorithm" = the full agent (plan, audit, render, inspect, edit).
EVO_FUSION_MODE=prompt
EVO_FUSION_PROMPT="create a hybrid of {a} and {b}"

# Daily caps and per-minute rate limits (runs and lab actions). false = no limits (usage is still counted).
EVO_LIMITS_ENABLED=false
