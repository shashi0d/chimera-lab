{
 "name": "cap_daily",
 "description": "POST refused: today's runs are used up. The gallery stays open.",
 "request": {
  "method": "POST",
  "path": "/evo/agent/runs",
  "contentType": "multipart/form-data",
  "fields": {
   "mode": "realistic"
  },
  "files": {
   "sireImage": "<photo of a Indian pangolin>",
   "damImage": "<photo of a horse>"
  }
 },
 "response": {
  "status": 429,
  "body": {
   "error": {
    "code": "CAP_REACHED",
    "retryable": false,
    "message": "Today's live creature runs are used up. The gallery is still open; new runs open again at 00:00 UTC.",
    "details": {
     "scope": "daily_total",
     "limit": 50,
     "resetsAt": "2026-11-03T00:00:00Z"
    }
   }
  }
 }
}
